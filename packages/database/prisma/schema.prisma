// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER & AUTH MODELS
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String? // Hashed password (null if OAuth only)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  projectMembers ProjectMember[]
  pages         Page[]
  feedbacks     Feedback[]
  activities    Activity[]
  apiKeys       ApiKey[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================================
// PROJECT & CONTENT MODELS
// ============================================================================

model Project {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  domain      String?  @unique // Custom domain
  subdomain   String?  @unique // project.docbolt.com

  // Settings
  visibility  ProjectVisibility @default(PRIVATE)

  // Branding
  logo        String?
  favicon     String?

  // Theme
  primaryColor    String @default("#3B82F6")
  secondaryColor  String @default("#10B981")
  accentColor     String @default("#F59E0B")
  darkMode        Boolean @default(true)
  customCss       String? @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  members     ProjectMember[]
  versions    Version[]
  pages       Page[]
  assets      Asset[]
  apiSpecs    ApiSpec[]
  changelogs  Changelog[]
  landingPage LandingPage?
  integrations Integration[]
  webhooks    Webhook[]
  feedbacks   Feedback[]
  analytics   Analytics[]
  activities  Activity[]

  @@map("projects")
}

enum ProjectVisibility {
  PUBLIC
  PRIVATE
  TEAM_ONLY
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      MemberRole  @default(VIEWER)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

enum MemberRole {
  OWNER
  EDITOR
  VIEWER
}

// ============================================================================
// VERSION MODELS
// ============================================================================

model Version {
  id          String         @id @default(cuid())
  projectId   String
  name        String         // v1.0, v2.0, etc.
  slug        String
  description String?
  isDefault   Boolean        @default(false)
  isPublished Boolean        @default(false)

  // Git integration
  gitBranch   String?
  gitCommit   String?

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pages       Page[]

  @@unique([projectId, slug])
  @@map("versions")
}

// ============================================================================
// PAGE & CONTENT MODELS
// ============================================================================

model Page {
  id          String      @id @default(cuid())
  projectId   String
  versionId   String

  title       String
  slug        String
  content     String      @db.Text // Markdown/MDX content
  excerpt     String?     @db.Text

  // Hierarchy
  parentId    String?
  order       Int         @default(0)

  // Metadata
  tags        String[]
  seo         Json?       // {title, description, keywords, ogImage}

  // Status
  status      PageStatus  @default(DRAFT)
  isHidden    Boolean     @default(false)

  // Author
  authorId    String

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  publishedAt DateTime?

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version     Version  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  author      User     @relation(fields: [authorId], references: [id])
  parent      Page?    @relation("PageHierarchy", fields: [parentId], references: [id])
  children    Page[]   @relation("PageHierarchy")
  feedbacks   Feedback[]

  @@unique([projectId, versionId, slug])
  @@index([projectId, versionId])
  @@index([parentId])
  @@map("pages")
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ============================================================================
// ASSET & FILE MODELS
// ============================================================================

model Asset {
  id        String   @id @default(cuid())
  projectId String

  filename  String
  path      String   // URL or file path
  size      Int
  mimeType  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("assets")
}

// ============================================================================
// API DOCUMENTATION MODELS
// ============================================================================

model ApiSpec {
  id          String   @id @default(cuid())
  projectId   String

  name        String
  description String?

  // OpenAPI spec
  spec        Json     // Full OpenAPI 3.x JSON
  format      String   @default("openapi") // openapi, swagger, asyncapi
  version     String   // 3.0, 3.1, etc.

  // Try-it config
  tryItEnabled Boolean @default(true)
  baseUrl      String?
  authType     String? // bearer, basic, oauth2, apiKey

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("api_specs")
}

// ============================================================================
// CHANGELOG MODELS
// ============================================================================

model Changelog {
  id          String         @id @default(cuid())
  projectId   String

  title       String
  content     String         @db.Text
  type        ChangelogType  @default(FEATURE)

  version     String? // Associated version (optional)
  publishedAt DateTime?

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("changelogs")
}

enum ChangelogType {
  FEATURE
  IMPROVEMENT
  FIX
  BREAKING
  SECURITY
  DEPRECATION
}

// ============================================================================
// LANDING PAGE MODELS
// ============================================================================

model LandingPage {
  id          String   @id @default(cuid())
  projectId   String   @unique

  content     Json     // Structured landing page content

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("landing_pages")
}

// ============================================================================
// INTEGRATION MODELS
// ============================================================================

model Integration {
  id          String          @id @default(cuid())
  projectId   String

  type        IntegrationType
  config      Json            // Integration-specific config

  isEnabled   Boolean         @default(true)

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("integrations")
}

enum IntegrationType {
  GITHUB
  GITLAB
  SLACK
  DISCORD
  GOOGLE_ANALYTICS
  CUSTOM
}

// ============================================================================
// WEBHOOK MODELS
// ============================================================================

model Webhook {
  id          String        @id @default(cuid())
  projectId   String

  url         String
  events      String[]      // ["page.published", "feedback.created", etc.]
  secret      String?

  isEnabled   Boolean       @default(true)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("webhooks")
}

// ============================================================================
// FEEDBACK MODELS
// ============================================================================

model Feedback {
  id          String       @id @default(cuid())
  projectId   String
  pageId      String
  userId      String?

  type        FeedbackType
  comment     String?      @db.Text

  // Metadata
  userAgent   String?
  ipAddress   String?

  createdAt   DateTime     @default(now())

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  page        Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user        User?   @relation(fields: [userId], references: [id])

  @@index([projectId, pageId])
  @@map("feedbacks")
}

enum FeedbackType {
  POSITIVE
  NEGATIVE
}

// ============================================================================
// ANALYTICS MODELS
// ============================================================================

model Analytics {
  id          String   @id @default(cuid())
  projectId   String

  // Event data
  event       String   // page_view, search, api_call, etc.
  path        String?
  metadata    Json?

  // User data
  userId      String?
  sessionId   String?

  // Request data
  userAgent   String?
  ipAddress   String?
  referrer    String?

  createdAt   DateTime @default(now())

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, event, createdAt])
  @@map("analytics")
}

// ============================================================================
// ACTIVITY LOG MODELS
// ============================================================================

model Activity {
  id          String   @id @default(cuid())
  projectId   String
  userId      String

  action      String   // "page.created", "page.updated", "version.published", etc.
  entityType  String   // "page", "version", "project", etc.
  entityId    String
  metadata    Json?

  createdAt   DateTime @default(now())

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User    @relation(fields: [userId], references: [id])

  @@index([projectId, createdAt])
  @@map("activities")
}

// ============================================================================
// API KEY MODELS
// ============================================================================

model ApiKey {
  id          String   @id @default(cuid())
  userId      String

  name        String
  key         String   @unique

  scopes      String[] // ["read", "write", "admin"]

  lastUsedAt  DateTime?
  expiresAt   DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}
